#!/bin/bash

set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
UPSTREAM_REF=${UPSTREAM_REF:-upstream/quattro}

cd "$ROOT"
git rev-parse --verify "$UPSTREAM_REF^{commit}" >/dev/null

RUSTC_WRAPPER= cargo +1.95.0 fmt --all -- --check
RUSTC_WRAPPER= cargo +1.95.0 clippy --all-targets -- -D warnings
RUSTC_WRAPPER= cargo +1.95.0 test --locked -p omarchy-command-runner
bash test/shell.d/power-present-test.sh
git diff --check "$UPSTREAM_REF"...HEAD

mapfile -t changed_paths < <(git diff --name-only --diff-filter=ACMR "$UPSTREAM_REF"...HEAD)
if (( ${#changed_paths[@]} > 0 )); then
  forbidden_pattern=$(printf '%s|' \
    'omni''dia' \
    'propr''ietary' \
    'private[ _-](api|identity|topology|path|credential)' \
    'road''map' \
    '/work''spaces/' \
    '/ho''me/')
  forbidden_pattern=${forbidden_pattern%|}
  leakage=$(git grep -nEi "$forbidden_pattern" -- "${changed_paths[@]}" || true)
  if [[ -n $leakage ]]; then
    printf '%s\n' "$leakage" >&2
    echo "Public-content audit rejected a downstream-only term" >&2
    exit 1
  fi
fi

printf 'upstream_source=%s\n' "$(git rev-parse "$UPSTREAM_REF")"
printf 'candidate_source=%s\n' "$(git rev-parse HEAD)"
echo "public_parity=pass"
